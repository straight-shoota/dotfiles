[core]
  autocrlf = false
  # fileMode = false
  whitespace = space-before-tab,trailing-space
  pager = delta

[column]
  ui = auto

[user]
  email = straightshoota@gmail.com
  name = Johannes Müller
  signingkey = F0F349637AC5087A

[diff]
  algorithm = histogram
  renames = copy
  wordregex = [^[:space:]]
  mnemonicprefix = true
  submodule = log
  tool = meld
  colormoved = zebra
  colormovedws = "allow-indentation-change"

[interactive]
  diffFilter = delta --color-only --features=interactive,decorations

[transfer]
  fsckobjects = true

[fetch]
  fsckobjects = true
  prune = true
  prunetags = true

[receive]
  fsckobjects = true

[commit]
  gpgsign = true
  verbose = true

[push]
  default = simple
  autoSetupRemote = true

[rerere]
  enabled = true
  autoupdate = true

[alias]
  a   = add
  ap  = '-c interactive.diffFilter="git diff --color-words" add --patch'
  b   = branch
  bc  = checkout --no-track -b # don't automatically track the same remote branch
  c   = commit
  cm  = commit -m
  co  = checkout
  d   = diff
  dc  = diff --cached
  fix = commit --fixup
  force-push = push --force-with-lease
  glog = log --graph --all --oneline --decorate
  hold = "!sh -c 'git update-ref refs/hold/$1 refs/heads/$1 && \
          git branch -D $1' -"
  s   = status -sb
  recent = ! git for-each-ref --sort=-committerdate refs/heads --format='%(HEAD)%(color:yellow)%(refname:short)|%(color:bold green)%(committerdate:relative)|%(color:blue)%(subject)|%(color:magenta)%(authorname)%(color:reset)' --color=always | column -ts'|'
  wip = for-each-ref --sort='authordate:iso8601' --format=' %(color:green)%(authordate:relative)%09%(color:default)%(if:equals="origin")%(upstream:remotename)%(then)%(color:yellow)%(end)%(if:equals="upstream")%(upstream:remotename)%(then)%(color:brightyellow)%(end)%(refname:short)%(color:default)%(if:notequals="Johannes Müller")%(authorname)%(then) (%(color:blue)%(authorname)%(color:white))%(end) %(color:brightblue)%(upstream:track)%(color:default)' refs/heads
  #local-branches = "!git branch --format '%(refname:short) %(upstream:short)' | awk '{if (!$2) print $1;}'"
  local-branches = "!git for-each-ref --sort --format '%(refname:short) %(upstream:short)' | awk '{if (!$2) print $1;}'"
  local-branches = "!git for-each-ref --sort='authordate:iso8601' --format=' %(color:green)%(authordate:relative)%09%(color:white)%(refname:short)%09%(color:cyan)%(upstream:short)' refs/heads | awk -F'\t' '{if (!$3) print $1 \"\t\" $2;}'"
  up  = !sh -c 'git push --set-upstream ${1:-origin} ${2:-$(git rev-parse --abbrev-ref HEAD)}' -
  grep-branch        = "!f(){ git branch -a | sed -e 's/[ \\*]*//' | grep -v -e '\\->' | xargs git grep $@; };f "
  grep-branch-remote = "!f(){ git branch -a | sed -e 's/[ \\]]*//' | grep -v -e '\\->' | grep '^remotes' | xargs git grep $@; };f"
  grep-branch-local  = "!f(){ git branch -a | sed -e 's/[ \\*]*//' | grep -v -e '\\->' -e '^remotes' | xargs git grep $@;  };f "

  # https://adamj.eu/tech/2022/10/27/git-how-to-alias-master-as-main/
  alias-main-as-master = !git symbolic-ref refs/heads/master refs/heads/main && git symbolic-ref refs/remotes/origin/master refs/remotes/origin/main
  alias-master-as-main = !git symbolic-ref refs/heads/main refs/heads/master && git symbolic-ref refs/remotes/origin/main refs/remotes/origin/master

[log]
  decorate = auto
  date = iso

[pull]
  rebase = true

[status]
  branch = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[url "git@github.com:"]
  pushInsteadOf = git://github.com/
  pushInsteadOf = https://github.com/
  insteadOf = "gh:"

[gpg]
  program = gpg

[init]
  templatedir = ~/.config/git/template
  defaultBranch = master

[merge]
  conflictstyle = zdiff3
  tool = meld

[branch]
  sort = -committerdate

[tag]
  sort = version:refname

[includeIf "gitdir/i:C:/"]
  path = ~/.config/git/config-windows

[delta]
  features = decorations

[delta "interactive"]
#  keep-plus-minus-markers = false
  side-by-side = true

[delta "decorations"]
  line-numbers = true
  commit-decoration-style = blue ol
  commit-style = raw
  file-style = omit
  hunk-header-decoration-style = omit #yellow box
  hunk-header-file-style = red
  hunk-header-line-number-style = "#067a00"
  hunk-header-style = file line-number syntax #yellow ul
