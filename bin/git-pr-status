#!/usr/bin/env bash

## Print PR status on GitHub
##
## Usage:
##
##    git pr-status [<branch>]
##

set -euo pipefail

if [ -z "${GITHUB_REPO:-}" ]; then
  upstream_url=$(git config remote.upstream.url)
  GITHUB_REPO=${upstream_url#*:}
fi

if [ $# -gt 0 ]; then
  branch=$1
else
  branch=$(git branch --show-current)
fi

pr="$(git config branch.${branch}.pr || :)"

[ -z "${pr}" ] && exit

info=$(gh pr view $pr --json state,isDraft -q '"\(.state) \(.isDraft)"')

case "$info" in
  *" true")
    printf ""
    ;;
  OPEN*)
    printf ""
    ;;
  CLOSED*)
    printf ""
    ;;
  *)
    printf "${info#* }"
esac
