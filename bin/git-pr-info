#!/usr/bin/env bash

## Print PR number with hyperlink for a branch
##
## Usage:
##
##    git pr-info [<branch>]
##

set -euo pipefail

if [ -z "${GITHUB_REPO:-}" ]; then
  upstream_url=$(git config remote.upstream.url)
  GITHUB_REPO=${upstream_url#*:}
fi

if [ $# -gt 0 ]; then
  branch=$1
else
  branch=$(git branch --show-current)
fi

pr="$(git config branch.${branch}.pr || :)"
if [ ! -z "${pr}" ]; then
  printf "\e]8;;https://github.com/${GITHUB_REPO}/issues/${pr}\e\\#${pr}\e]8;;\e\\"
fi

issue="$(git config branch.${branch}.issue || :)"
if [ ! -z "${issue}" ]; then
  if [ ! -z "${pr}" ]; then
    printf " "
  fi
  printf " \e]8;;https://github.com/${GITHUB_REPO}/issues/${issue}\e\\#${issue}\e]8;;\e\\"
fi
