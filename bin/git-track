#!/usr/bin/env bash

## Add PR tracking information to a git branch
##
## Usage:
##
##    git track [[<branch>] <PR/issue number>]
##

set -euo pipefail

if [ $# -eq 2 ]; then
  branch=$1
  number=$2
elif [ $# -eq 1 ]; then
  number=$1
  branch=$(git branch --show-current)
else
  branch=$(git branch --show-current)
  remote=$(git config branch.$branch.remote)

  case "${remote}" in
    origin)
      remote="straight-shoota:"
    ;;
    upstream)
      remote=""
    ;;
    *)
  esac

  number=$(gh pr view $remote$branch --json number -q '.number' || :)
fi

# strip leading hashtag (if any)
number=${number#\#}

[ -z "${number}" ] && exit 1

git config "branch.${branch}.pr" "$number"
